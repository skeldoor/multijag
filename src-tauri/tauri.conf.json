{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MultiJag",
  "version": "0.1.0",
  "identifier": "local.multijag",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "MultiJag", "width": 560, "height": 680, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
